# Application environment: development, staging, or production
APP_ENV=development

# App display name used in Swagger docs and logs
APP_NAME=chevstyle-backend

# FastAPI debug mode flag (true only in development)
APP_DEBUG=true

# Clerk JWKS URL for verifying JWTs
CLERK_JWKS_URL=

# Clerk JWT issuer claim
CLERK_ISSUER=

# Clerk JWT audience claim
CLERK_AUDIENCE=

# Convex HTTP endpoint URL
CONVEX_URL=

# Convex deployment key for API access
CONVEX_DEPLOY_KEY=
